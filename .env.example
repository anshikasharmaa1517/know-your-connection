# Copy to .env and fill in. docker compose reads it automatically.
OPENAI_API_KEY=
# Any OpenAI model that supports structured outputs.
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# FalkorDB. Local: redis://localhost:6379. FalkorDB Cloud: redis://default:<password>@<host>:<port>
FALKORDB_URL=redis://localhost:6379
# Where the app is reachable, used in the opt-in links friends send.
CIRQL_PUBLIC_URL=http://localhost:8000
