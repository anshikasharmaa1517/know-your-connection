# Copy to .env and fill in. docker compose reads it automatically.
#
# Model: AWS Bedrock or OpenAI. The app picks whichever key is set
# (or set LLM_PROVIDER=bedrock / openai / offline to choose).

# AWS Bedrock: a Bedrock API key (Bedrock console > API keys), and the region it was made in.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# Optional. Defaults shown. Any Bedrock model that supports tool use works.
# BEDROCK_MODEL_ID=global.anthropic.claude-haiku-5-5
# BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# Tried in order if AWS refuses the main model. Default: Amazon Nova 2 Lite. "none" turns it off.
# BEDROCK_FALLBACK_MODEL_IDS=global.amazon.nova-2-lite-v1:0
# Instead of an API key you can use AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.

# OpenAI (alternative). Any model that supports structured outputs.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# FalkorDB. Either one URL...
#   Local:          redis://localhost:6379
#   FalkorDB Cloud: redis://falkordb:<password>@<host>:<port>
FALKORDB_URL=redis://localhost:6379
# ...or separate fields, which win over FALKORDB_URL when FALKORDB_HOST is set.
# Easiest for FalkorDB Cloud: paste host, port and password from its Connect dialog.
# FALKORDB_HOST=
# FALKORDB_PORT=
# FALKORDB_USERNAME=falkordb
# FALKORDB_PASSWORD=
# FALKORDB_TLS=false
# Where the app is reachable, used in the opt-in links friends send.
CONNECTIONS_PUBLIC_URL=http://localhost:8000
