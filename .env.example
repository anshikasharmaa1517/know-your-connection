# Copy to .env and fill in. docker compose reads it automatically.
OPENAI_API_KEY=
# Any OpenAI model that supports structured outputs.
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# FalkorDB. Either one URL...
#   Local:          redis://localhost:6379
#   FalkorDB Cloud: redis://falkordb:<password>@<host>:<port>
FALKORDB_URL=redis://localhost:6379
# ...or separate fields, which win over FALKORDB_URL when FALKORDB_HOST is set.
# Easiest for FalkorDB Cloud: paste host, port and password from its Connect dialog.
# FALKORDB_HOST=
# FALKORDB_PORT=
# FALKORDB_USERNAME=falkordb
# FALKORDB_PASSWORD=
# FALKORDB_TLS=false
# Where the app is reachable, used in the opt-in links friends send.
CONNECTIONS_PUBLIC_URL=http://localhost:8000
